# Hojas y carpetas de Drive.
# El id se copia de la dirección del navegador.
# DRIVE_SHEETS_ID y DRIVE_RESPONSES_FOLDER hacen falta para arrancar.

# Hoja de registro de RT.
DRIVE_SHEETS_ID=
# Carpeta donde se guardan las respuestas.
DRIVE_RESPONSES_FOLDER=
# Hoja de Entes. Hace falta para ese paso.
DRIVE_SHEETS_ENTES_ID=
# Carpeta de PDF. Vacía: se usa DRIVE_RESPONSES_FOLDER.
DRIVE_PDF_FOLDER=
# Carpeta de fotos. Vacía: se usa DRIVE_RESPONSES_FOLDER.
DRIVE_SCREENSHOTS_FOLDER=

# Etiquetas de Gmail.
# Crear una etiqueta por categoría. El id sale con: python scripts/lector_etiquetas.py
# Pegar solo el código que aparece después de la flecha.
# GMAIL_LABEL_ID hace falta para arrancar.

# RT bloqueado. Correo de un repartidor con la cuenta bloqueada.
GMAIL_LABEL_ID=
# Revisión manual. Correo que debe ver una persona.
GMAIL_LABEL_REVISION_MANUAL=
# Entes. Reclamo de un cliente final.
GMAIL_LABEL_ENTES=
# Otros.
GMAIL_LABEL_OTROS=
# Facturación.
GMAIL_LABEL_FACTURACION=
# Restaurantes.
GMAIL_LABEL_RESTAURANTES=
# Eliminar deuda del repartidor.
GMAIL_LABEL_ELIMINAR_DEUDA_RTS=

# Cartas.
# Id de cada Documento de Google. No modificar las llaves del documento.

# Cuenta bloqueada, con foto. Se sube formatos/DOC_TEMPLATE_BLOCKED.docx.
DOC_TEMPLATE_BLOCKED=
# Cuenta bloqueada, sin foto.
DOC_TEMPLATE_RT_WITHOUT_ANEXOS=
# Representación legal, con foto.
DOC_TEMPLATE_RT_RL=
# Representación legal, sin foto.
DOC_TEMPLATE_RT_RL_WITHOUT_ANEXOS=
# Terceros.
DOC_TEMPLATE_THIRD_PARTY=

# Correo de respuesta.
# Hace falta para arrancar. No tiene otro valor.

# Correo al que se responde en el hilo de Legal.
GMAIL_REPLY_TO=

# Slack.
# En esta entrega el token, el canal y los dos usuarios ya vienen en el .env.
# SLACK_REVIEW_CHANNEL_ID hace falta para arrancar.

# Canal donde se piden las decisiones. El envío usa este id, no el nombre.
SLACK_REVIEW_CHANNEL_ID=
# Nombre del canal.
SLACK_REVIEW_CHANNEL_NAME=
# Token del bot.
SLACK_BOT_TOKEN=
# Usuario que se menciona si la regla contiene fraud.
SLACK_REVIEW_USER_FRAUD=
# Usuario que se menciona en el resto de reglas.
SLACK_REVIEW_USER_DISCIPLINE=

# Claves de inteligencia artificial.
# Hace falta al menos una para arrancar.

# Clave de Groq. Se crea en console.groq.com.
GROQ_API_KEY=
# Clave de Gemini. Se crea en Google AI Studio.
GEMINI_API_KEY=

# Archivos de Google.
# Dejar vacías si los archivos están en data-json.

# Ruta del credentials.json. Vacía: data-json/credentials.json.
# Solo se llena si el archivo no está en esa carpeta.
GOOGLE_CREDENTIALS_FILE=
# Ruta del token.json. Vacía: data-json/token.json. Lo crea el primer permiso de Google.
GOOGLE_TOKEN_FILE=

# Si se deja vacío, el programa ya tiene un valor.

# Inteligencia artificial.

# groq o gemini. Vacía: groq. Si ese proveedor falla, se usa el otro.
IA_PROVIDER=
# Segunda clave de Groq. Vacía: se usa GROQ_API_KEY.
GROQ_API_KEY2=
# Modelo de Groq. Vacía: openai/gpt-oss-120b.
GROQ_MODEL=
# Modelo de Gemini. También lee PDF e imágenes. Vacía: gemini-2.5-flash.
GEMINI_MODEL=

# Direcciones.

# Dirección de Lupe. Vacía: https://lupe.rappi.com/.
URL_LUPE=
# Dirección del formulario de Entes. Vacía: https://master.d3i85um4nwfu2v.amplifyapp.com/.
URL_FORMULARIO=

# Correos que van a revisión de una persona.
# No tiene que ver con el formulario de Entes.

# Correos extra, separados por coma. Vacía: solo entra recepcion.hub@rappi.com.
CORREOS_REVISION_MANUAL=

# Dashboard y ciclo.

# true deja el correo en borrador. false lo envía. Vacía: false. Se cambia en pausa o sin ciclo.
CONTROL_CALIDAD=
# true espera Continuar después de clasificar. Vacía: false, el ciclo sigue solo.
REVISION_CLASIFICACION=
# Horas entre ciclos. Vacía: 4.
CICLO_HORAS=
# Puerto del dashboard. Vacía: 8000.
DASHBOARD_PUERTO=
# Canales de aviso, separados por coma: toast, gmail, slack. Vacía: toast,gmail.
ALERTAS_CANALES=
# Correo que recibe las alertas de Gmail. Vacía: no se envía ese aviso.
ALERTAS_EMAIL=
# Canal de Slack para alertas. Vacía: no se envía ese aviso.
ALERTAS_SLACK_CANAL=

# Entrada a Lupe.

# interactivo espera la clave de Google. automatico sale con código 20. Vacía: interactivo.
LUPE_MODO=
# Carpeta del perfil de Lupe. Vacía: %LOCALAPPDATA%\ProyectoE\lupe_profile.
LUPE_PROFILE_DIR=
# Vacía: Chromium de Playwright. chrome: el Chrome instalado, si Google bloquea el otro.
LUPE_CHANNEL=
