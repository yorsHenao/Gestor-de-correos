# ============================================================================
# Proyecto E — plantilla del archivo .env
# INSTALAR.bat copia este archivo a .env y pregunta lo que falte.
# Aquí NO van claves ni tokens: solo nombres y valores comunes del equipo.
# ============================================================================

# --- 1. Credenciales de Google (rutas; los archivos los pone el instalador) ---
GOOGLE_CREDENTIALS_FILE=data-json/credentials.json
GOOGLE_TOKEN_FILE=data-json/token.json

# --- 2. Gmail ---
# Correo al que se responden los casos (obligatorio; lo pregunta el instalador)
GMAIL_REPLY_TO=
# IDs de las etiquetas (Label_...). El instalador las crea o las encuentra y llena estos valores.
GMAIL_LABEL_ID=
GMAIL_LABEL_REVISION_MANUAL=
GMAIL_LABEL_ENTES=
GMAIL_LABEL_OTROS=
GMAIL_LABEL_FACTURACION=
GMAIL_LABEL_RESTAURANTES=
GMAIL_LABEL_ELIMINAR_DEUDA_RTS=
# Correos extra (separados por coma) que siempre van a revisión manual
CORREOS_REVISION_MANUAL=

# --- 3. Google Drive y Sheets (los llena el instalador al crear la carpeta legal-ops) ---
DRIVE_SHEETS_ID=
DRIVE_SHEETS_ENTES_ID=
DRIVE_RESPONSES_FOLDER=
DRIVE_PDF_FOLDER=
DRIVE_SCREENSHOTS_FOLDER=

# --- 4. Plantillas de Google Docs (las sube el instalador desde plantillas/) ---
DOC_TEMPLATE_BLOCKED=
DOC_TEMPLATE_THIRD_PARTY=
DOC_TEMPLATE_RT_RL=
DOC_TEMPLATE_RT_WITHOUT_ANEXOS=
DOC_TEMPLATE_RT_RL_WITHOUT_ANEXOS=

# --- 5. Slack (canal y personas de OPS: iguales para todo el equipo) ---
# Token del bot: lo entrega Jeisembert a cada persona; el instalador lo pide.
SLACK_BOT_TOKEN=
SLACK_REVIEW_CHANNEL_ID=C0B1T9NB342
SLACK_REVIEW_CHANNEL_NAME=#derechos-de-peticion-co
# Personas de OPS que se etiquetan según el tipo de bloqueo
SLACK_REVIEW_USER_FRAUD=UTQESFBHD
SLACK_REVIEW_USER_DISCIPLINE=UUNLVJFEY

# --- 6. Inteligencia artificial (cada persona usa sus propias claves; al menos una) ---
# Proveedor principal: groq o gemini (si falla, se usa el otro de respaldo)
IA_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Segundos máximos de espera por respuesta de Gemini (vacío = 120)
GEMINI_TIMEOUT_SEG=

# --- 7. Lupe y formulario de Entes (vacío = valor por defecto del programa) ---
URL_LUPE=https://lupe.rappi.com/
URL_FORMULARIO=https://master.d3i85um4nwfu2v.amplifyapp.com/
LUPE_PROFILE_DIR=
LUPE_CHANNEL=
LUPE_MODO=interactivo
LUPE_REINGRESO_SEG=30
LUPE_LOGIN_MAX_SEG=300
LUPE_LOCK_ESPERA_SEG=1800
ENTES_MAX_CORREOS=26
ENTES_TIMEOUT_FORM=120
ENTES_MAX_INTENTOS=3
ENTES_MAX_FALLOS_RONDA=2
ENTES_MAX_IMAGENES=3

# --- 8. Servicio, dashboard y alertas ---
CICLO_HORAS=4
PASO_TIMEOUT_MIN=120
DASHBOARD_PUERTO=8000
# true = crea borradores en Gmail | false = envía directamente
CONTROL_CALIDAD=true
# true = pausa el ciclo después de "clasificar" hasta pulsar Continuar en el Dashboard
REVISION_CLASIFICACION=true
# Canales de alerta separados por coma: toast, gmail, slack
ALERTAS_CANALES=toast,gmail
ALERTAS_EMAIL=
ALERTAS_SLACK_CANAL=
